# Copy this file to ".env" and edit. Never commit the real .env file.

# Secret used to sign login sessions. REQUIRED for deployment.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# (If left empty in development, a random key is generated in instance/secret_key.)
SECRET_KEY=

# Set to 1 when serving over HTTPS so session cookies are only sent securely.
SESSION_COOKIE_SECURE=0

# Optional overrides
# DATABASE_PATH=instance/spamguard.db
# DATASET_PATH=spam.csv
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=0     # set to 1 only on your own machine while developing
